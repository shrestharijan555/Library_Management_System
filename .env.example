# ==============================================================================
# EduLibrary LMS — Environment Configuration Template
# ==============================================================================
# Duplicate this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# In Supabase, use the Transaction Pooler connection string (Port 6543) for serverless environments.
# Example: postgres://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgres://postgres:your_password@localhost:5432/edulibrary"

# ------------------------------------------------------------------------------
# 2. Supabase Public Client Credentials (Safe for browser client components)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# ------------------------------------------------------------------------------
# 3. Supabase Server Secret Key (SERVER-SIDE ONLY — NEVER expose to browser)
# ------------------------------------------------------------------------------
# Used for administrative profile synchronization and automated database seeding.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# ------------------------------------------------------------------------------
# 4. Application URL & Auth Redirects
# ------------------------------------------------------------------------------
# Used for constructing authentication callback and password recovery redirects.
# Local: http://localhost:3000
# Production: https://your-library-domain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
