# Copy this file to .env.local for local development.
# Do not put real secrets in this file or in git.
# These variables are not used in Phase 1. They will be required in later phases.

# PostgreSQL connection string (Supabase or local Postgres)
DATABASE_URL=

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key (safe to expose to the browser; not a secret admin key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
