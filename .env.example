# Copy this file to .env.local for local development.
# Do not put real secrets in this file or in git.

# PostgreSQL connection string (Supabase or local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/library_db

# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe to expose to the browser; public client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (OPTIONAL: server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

